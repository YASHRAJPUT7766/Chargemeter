<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Design language: "precision instrument panel" — the world of
        oscilloscopes, multimeters, and power analyzers, not generic
        "dark mode app" defaults. See ui/theme/Color.kt for the full
        token system used by Compose; these XML values back the
        widget (Glance/RemoteViews) and app icon only, since those
        can't consume Compose color tokens directly.
    -->
    <color name="instrument_bg">#0A0E12</color>
    <color name="instrument_surface">#0F1720</color>
    <color name="instrument_surface_raised">#141E29</color>
    <color name="phosphor_green">#39FF88</color>
    <color name="phosphor_green_dim">#1F8F52</color>
    <color name="warning_amber">#FF6B4A</color>
    <color name="voltage_blue">#5B8DEF</color>
    <color name="panel_gray">#8B98A5</color>
    <color name="panel_gray_dim">#5A6470</color>
    <color name="hairline">#22303C</color>
    <color name="white">#FFFFFF</color>
    <color name="critical_red">#FF4757</color>
</resources>
