<?xml version="1.0" encoding="utf-8"?>
<!--
    Controls what's included in device-to-device transfer and cloud backup
    on Android 12+. We only back up local app preferences and the Room DB
    (charging history) — this is local data staying local, just moving with
    the user to a new device. No network transmission happens unless the
    user has separately opted into cloud backup (not implemented by default).
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
