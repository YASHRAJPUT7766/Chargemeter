<!--
    Shown in the system's "add widget" picker UI. A simplified static
    approximation of the live widget's layout — real widget previews
    can't be dynamic, so this mocks typical content (battery %, status
    dot, wattage bar) on the instrument-panel background rather than
    leaving the picker slot blank.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="180dp"
    android:height="110dp"
    android:viewportWidth="180"
    android:viewportHeight="110">
    <path android:pathData="M0,0h180v110h-180z" android:fillColor="#0A0E12" />
    <!-- battery % placeholder -->
    <path android:pathData="M12,20h50v20h-50z" android:fillColor="#39FF88" android:fillAlpha="0.15" />
    <!-- watt reading bar -->
    <path android:pathData="M12,50h90v14h-90z" android:fillColor="#39FF88" android:fillAlpha="0.25" />
    <!-- secondary readings row -->
    <path android:pathData="M12,72h140v8h-140z" android:fillColor="#8B98A5" android:fillAlpha="0.2" />
</vector>
