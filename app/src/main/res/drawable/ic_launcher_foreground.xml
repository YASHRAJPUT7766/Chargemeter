<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground: a lightning bolt centered inside a partial
    gauge-tick ring, rendered in the app's phosphor-green primary accent.
    Kept within the safe zone (center 66dp of the 108dp canvas, per
    Android's adaptive icon spec) so it isn't clipped by circular, squircle,
    or rounded-square OEM icon masks.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Partial ring with tick marks, echoing the WattMeterGauge dial -->
    <path
        android:pathData="M54,20 A34,34 0 1,1 20,54"
        android:strokeColor="#39FF88"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Lightning bolt, centered -->
    <path
        android:pathData="M58,28 L40,58 L52,58 L48,80 L70,50 L57,50 Z"
        android:fillColor="#39FF88" />
</vector>
